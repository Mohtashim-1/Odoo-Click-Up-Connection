<odoo>
  <record id="ir_cron_clickup_task_sync" model="ir.cron">
    <field name="name">Fetch ClickUp Tasks Every 30 Minutes</field>
    <field name="model_id" ref="model_clickup_list"/>
    <field name="state">code</field>
    <field name="code">model.cron_fetch_clickup_tasks()</field>
    <field name="interval_number">30</field> <!-- Updated from 1 to 30 -->
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="active" eval="True"/>
    <field name="user_id" ref="base.user_admin"/>
  </record>
</odoo>
