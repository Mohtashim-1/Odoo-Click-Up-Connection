<odoo>
  <record id="view_clickup_list_tree" model="ir.ui.view">
    <field name="name">clickup.list.tree</field>
    <field name="model">clickup.list</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="list_id"/>
        <field name="space_id"/>
        <field name="team_id"/>
        <field name="user_id"/>
      </tree>
    </field>
  </record>

  <record id="view_clickup_list_form" model="ir.ui.view">
    <field name="name">clickup.list.form</field>
    <field name="model">clickup.list</field>
    <field name="arch" type="xml">
      <form string="ClickUp List">
        <sheet>
          <group>
            <field name="name"/>
            <field name="list_id"/>
            <field name="space_id"/>
            <field name="team_id"/>
            <field name="user_id"/>
            <button name="action_fetch_tasks_from_list"
        type="object"
        string="Fetch Tasks"
        class="btn-primary"/>

          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_clickup_list" model="ir.actions.act_window">
    <field name="name">ClickUp Lists</field>
    <field name="res_model">clickup.list</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_clickup_list" name="Lists" parent="menu_clickup_root" action="action_clickup_list"/>
</odoo>
