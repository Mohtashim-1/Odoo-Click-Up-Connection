<odoo>
    <record id="view_clickup_folder_tree" model="ir.ui.view">
        <field name="name">clickup.folder.tree</field>
        <field name="model">clickup.folder</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="folder_id"/>
                <field name="space_id"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_clickup_folder_form" model="ir.ui.view">
        <field name="name">clickup.folder.form</field>
        <field name="model">clickup.folder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="folder_id"/>
                        <field name="space_id"/>
                        <field name="user_id"/>
                        <button name="action_fetch_folders_from_clickup"
                                string="Fetch Folders from ClickUp"
                                type="object"
                                class="btn btn-primary"/>
                        <button name="action_fetch_lists_from_folder"
        type="object"
        string="Fetch Lists"
        class="btn-primary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clickup_folder" model="ir.actions.act_window">
        <field name="name">ClickUp Folders</field>
        <field name="res_model">clickup.folder</field>
        <field name="view_mode">tree,form</field>

    </record>

    <menuitem id="menu_clickup_folder" name="Folders" parent="menu_clickup_root" action="action_clickup_folder"/>
</odoo>